{
    "name": "el-schneider/statamic-html-minify",
    "description": "An addon to minify HTML for Statamic 5 and 6",
    "keywords": [
        "octoper",
        "statamic-html-minify"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Vaggelis Yfantis",
            "email": "me@octoper.me",
            "homepage": "https://octoper.me",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "statamic/cms": "^5.0 || ^6.0",
        "voku/html-min": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.8",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0 || ^5.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage-html coverage",
        "format": "vendor/bin/php-cs-fixer fix --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "ElSchneider\\HtmlMinify\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ElSchneider\\HtmlMinify\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "HTML Minify",
            "description": "An addon to minify HTML for Statamic 5 and 6"
        },
        "laravel": {
            "providers": [
                "ElSchneider\\HtmlMinify\\HtmlMinifyServiceProvider"
            ]
        }
    }
}
